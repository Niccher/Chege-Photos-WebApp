#--------------------------------------------------------------------
# Example Environment Configuration file
#--------------------------------------------------------------------
# This file serves as a template for your .env file.
# Copy this to .env and fill in the details for your environment.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# App Settings
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

# Database Settings
database.default.hostname = localhost
database.default.database = your_database_name
database.default.username = your_username
database.default.password = your_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Encryption Settings (Generate with: php spark key:generate)
encryption.key = 

#--------------------------------------------------------------------
# Admin / Super Admin Seeder Credentials
# Used by: php spark db:seed AdminSeeder / SuperAdminSeeder
#--------------------------------------------------------------------
ADMIN_EMAIL = admin@eavesdroid.com
ADMIN_PASSWORD = Admin@2024!
ADMIN_USERNAME = admin

SUPERADMIN_EMAIL = superadmin@eavesdroid.com
SUPERADMIN_PASSWORD = SuperAdmin@2024!
SUPERADMIN_USERNAME = superadmin

