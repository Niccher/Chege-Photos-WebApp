# CodeIgniter 4 standard ignores
.env
/vendor/
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
/writable/uploads/*
/writable/exports/*
/writable/backups/*
!/writable/cache/.gitkeep
!/writable/debugbar/.gitkeep
!/writable/logs/.gitkeep
!/writable/session/.gitkeep
!/writable/uploads/.gitkeep
!/writable/exports/.gitkeep
!/writable/backups/.gitkeep

# Public user-uploaded content
/public/uploads/*
/public/thumbnails/*
!/public/uploads/.gitkeep
!/public/thumbnails/.gitkeep

# IDE, OS and development files
.idea/
.vscode/
*.swp
*.bak
.DS_Store
Thumbs.db
node_modules/

# Ignore writable logs and debugbar
writable/logs/*
!writable/logs/index.html
writable/debugbar/*
!writable/debugbar/index.html
=*
