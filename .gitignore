# CodeIgniter 4 standard ignores
# Environment files
.env
.env.*
!.env.example
!.env.docker

# Composer dependencies
/vendor/

# Writable directory contents
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
/writable/uploads/*
/writable/exports/*
/writable/backups/*
!/writable/cache/.gitkeep
!/writable/debugbar/.gitkeep
!/writable/logs/.gitkeep
!/writable/session/.gitkeep
!/writable/uploads/.gitkeep
!/writable/exports/.gitkeep
!/writable/backups/.gitkeep

# Public user-uploaded content
/public/uploads/*
/public/thumbnails/*
!/public/uploads/.gitkeep
!/public/thumbnails/.gitkeep

# Credentials, private keys, and cloud certificates
*-credentials.json
*credentials*.json
gcp-key.json
*.pem
*.key
*.p12
*.pfx

# Test, linter, and build caches
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.phpcs-cache

# Local SQLite databases
/writable/*.db

# Agent and AI assistant configurations & skills
.agents/

# IDE, OS, and Temporary files
.idea/
.vscode/
*.swp
*.swo
*.bak
*.tmp
*.temp
*~
.DS_Store
Thumbs.db
node_modules/
=*
